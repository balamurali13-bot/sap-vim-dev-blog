---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const publishedPosts = posts.filter(p => p.data.status === 'published').sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const featuredPost = publishedPosts.find(p => p.data.featured) || publishedPosts[0];
const recentPosts = publishedPosts.slice(0, 3);

// Get authors for name lookup
const authors = await getCollection('authors');
const getAuthorName = (slug: string) => {
  const author = authors.find(a => a.slug === slug);
  return author ? author.data.name : slug.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
};
const getAuthorInitials = (slug: string) => {
  const name = getAuthorName(slug);
  return name.split(' ').map(n => n.charAt(0)).join('');
};

const categories = [
  { slug: 'abap-snippets', name: 'ABAP Code', icon: '📝', desc: 'Practical ABAP examples' },
  { slug: 'vim-enhancements', name: 'VIM Enhancements', icon: '⚡', desc: 'Custom extensions' },
  { slug: 'workflow', name: 'Workflow', icon: '🔄', desc: 'Automation patterns' },
  { slug: 'troubleshooting', name: 'Troubleshooting', icon: '🔧', desc: 'Debug guides' },
  { slug: 'performance', name: 'Performance', icon: '🚀', desc: 'Optimization tips' },
  { slug: 'fi-mm', name: 'FI/MM Integration', icon: '🔗', desc: 'SAP connectors' },
];

const categoryColors: Record<string, string> = {
  'abap-snippets': 'bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400',
  'vim-enhancements': 'bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400',
  'workflow': 'bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400',
  'fi-mm': 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400',
  'troubleshooting': 'bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400',
  'performance': 'bg-cyan-100 dark:bg-cyan-900/30 text-cyan-700 dark:text-cyan-400',
  'best-practices': 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-400',
};
---

<BaseLayout title="Home">
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-slate-900 dark:bg-slate-950 text-white py-20 lg:py-28">
    <!-- Background Pattern -->
    <div class="absolute inset-0 opacity-10">
      <div class="absolute inset-0" style="background-image: radial-gradient(circle at 2px 2px, white 1px, transparent 0); background-size: 32px 32px;"></div>
    </div>
    
    <div class="relative container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/20 text-cyan-400 text-sm font-medium mb-6">
          <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
          For SAP Practitioners
        </div>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold tracking-tight mb-6">
          SAP & VIM Engineering
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500">Resources</span>
        </h1>
        <p class="text-lg sm:text-xl text-slate-300 mb-8 max-w-2xl">
          Weekly ABAP code snippets, SAP VIM enhancement guides, and practical troubleshooting from experienced consultants.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="/blog" class="inline-flex items-center px-6 py-3 text-base font-semibold rounded-lg bg-cyan-600 hover:bg-cyan-500 text-white transition-all shadow-lg shadow-cyan-500/25">
            Browse Articles
          </a>
          <a href="/contact" class="inline-flex items-center px-6 py-3 text-base font-semibold rounded-lg border border-slate-600 hover:border-slate-500 text-white transition-all">
            Get Consultation
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Article -->
  {featuredPost && (
    <section class="py-16 -mt-8 relative z-10">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="bg-white dark:bg-slate-800 rounded-2xl shadow-xl border border-slate-200 dark:border-slate-700 overflow-hidden">
          <div class="grid lg:grid-cols-2">
            <div class="p-8 lg:p-12 flex flex-col justify-center">
              <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white mb-4">
                <a href={`/blog/${featuredPost.slug}`} class="hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors">
                  {featuredPost.data.title}
                </a>
              </h2>
              <div class="flex items-center gap-3 mb-4">
                <span class={`px-3 py-1 rounded-full text-xs font-semibold uppercase ${categoryColors[featuredPost.data.category] || 'bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-400'}`}>
                  {featuredPost.data.category.replace('-', ' ')}
                </span>
                <span class="text-slate-500 dark:text-slate-400 text-sm">{featuredPost.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
              </div>
              <p class="text-slate-600 dark:text-slate-400 mb-6">{featuredPost.data.description}</p>
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2">
                  <div class="w-8 h-8 rounded-full bg-gradient-to-br from-purple-500 to-purple-600 flex items-center justify-center text-white text-xs font-bold">
                    {getAuthorInitials(featuredPost.data.author)}
                  </div>
                  <span class="text-sm font-medium text-slate-500 dark:text-slate-400">{getAuthorName(featuredPost.data.author)}</span>
                </div>
                <a href={`/blog/${featuredPost.slug}`} class="inline-flex items-center gap-2 text-cyan-600 dark:text-cyan-400 font-semibold hover:gap-3 transition-all">
                  Read Article →
                </a>
              </div>
            </div>
            <div class="bg-gradient-to-br from-slate-100 dark:from-slate-700 to-slate-50 dark:to-slate-800 lg:border-l border-slate-200 dark:border-slate-700 p-8 lg:p-12 flex items-center justify-center">
              <div class="text-center">
                <div class="w-20 h-20 mx-auto mb-4 rounded-2xl bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center">
                  <span class="text-3xl">📄</span>
                </div>
                <p class="text-slate-600 dark:text-slate-400 font-medium">{featuredPost.data.category.replace('-', ' ')}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Categories Grid -->
  <section class="py-16 bg-slate-50 dark:bg-slate-900">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white mb-4">Topics</h2>
        <p class="text-slate-600 dark:text-slate-400 max-w-2xl mx-auto">Explore our technical resources by category</p>
      </div>
      
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {categories.map(cat => (
          <a href={`/category/${cat.slug}`} class="group bg-white dark:bg-slate-800 rounded-xl p-6 border border-slate-200 dark:border-slate-700 hover:border-cyan-300 dark:hover:border-cyan-600 hover:shadow-lg hover:shadow-cyan-500/10 transition-all">
            <div class="text-3xl mb-4">{cat.icon}</div>
            <h3 class="font-semibold text-slate-900 dark:text-white mb-2 group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors">{cat.name}</h3>
            <p class="text-sm text-slate-500 dark:text-slate-400">{cat.desc}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Recent Articles -->
  <section class="py-16">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center justify-between mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white">Recent Articles</h2>
        <a href="/blog" class="text-cyan-600 dark:text-cyan-400 font-semibold hover:text-cyan-700 dark:hover:text-cyan-300 transition-colors">View all →</a>
      </div>
      
      <div class="grid md:grid-cols-3 gap-8">
        {recentPosts.map(post => (
          <article class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden hover:shadow-lg hover:border-cyan-200 dark:hover:border-cyan-600 transition-all group">
            <div class="p-6">
              <div class="flex items-center gap-3 mb-4">
                <span class={`px-2 py-1 rounded-md text-xs font-medium uppercase ${categoryColors[post.data.category] || 'bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-400'}`}>
                  {post.data.category.replace('-', ' ')}
                </span>
                <span class="text-slate-400 dark:text-slate-500 text-sm">{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}</span>
              </div>
              <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-3 group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors line-clamp-2">
                <a href={`/blog/${post.slug}`}>{post.data.title}</a>
              </h3>
              <p class="text-slate-600 dark:text-slate-400 text-sm mb-4 line-clamp-2">{post.data.description}</p>
              <div class="flex items-center justify-between">
                <span class="text-xs text-slate-500 dark:text-slate-500">{getAuthorName(post.data.author)}</span>
                <a href={`/blog/${post.slug}`} class="text-cyan-600 dark:text-cyan-400 text-sm font-medium hover:underline">Read →</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="py-20 bg-gradient-to-br from-cyan-600 to-blue-700">
    <div class="container mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-white mb-4">Ready to Get Started?</h2>
      <p class="text-cyan-100 text-lg mb-8 max-w-2xl mx-auto">
        Whether you need help with SAP VIM implementation, ABAP development, or technical consulting, we're here to help.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contact" class="inline-flex items-center px-8 py-4 text-lg font-semibold rounded-lg bg-white text-cyan-700 hover:bg-cyan-50 transition-colors shadow-lg">
          Contact Us
        </a>
        <a href="/blog" class="inline-flex items-center px-8 py-4 text-lg font-semibold rounded-lg border border-cyan-400 text-white hover:bg-cyan-500/20 transition-colors">
          Read Articles
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
