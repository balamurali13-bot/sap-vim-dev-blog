---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Services">
  <h1 class="text-4xl font-bold mb-8">Our Services</h1>
  
  <div class="grid md:grid-cols-2 gap-6">
    <div class="bg-white p-6 rounded-lg shadow">
      <h2 class="text-xl font-bold mb-3">SAP VIM Implementation</h2>
      <p class="text-slate-600 mb-4">End-to-end OpenText VIM deployment and configuration for enterprise invoice processing.</p>
      <ul class="text-sm space-y-1 text-slate-500">
        <li>• Invoice capture setup</li>
        <li>• Workflow configuration</li>
        <li>• FI/MM integration</li>
      </ul>
    </div>
    
    <div class="bg-white p-6 rounded-lg shadow">
      <h2 class="text-xl font-bold mb-3">ABAP Development</h2>
      <p class="text-slate-600 mb-4">Custom ABAP development for VIM enhancements and integrations.</p>
      <ul class="text-sm space-y-1 text-slate-500">
        <li>• Custom exit implementations</li>
        <li>• IDoc development</li>
        <li>• BAdI implementations</li>
      </ul>
    </div>
    
    <div class="bg-white p-6 rounded-lg shadow">
      <h2 class="text-xl font-bold mb-3">Code Review</h2>
      <p class="text-slate-600 mb-4">Comprehensive review of your ABAP and VIM customizations.</p>
      <ul class="text-sm space-y-1 text-slate-500">
        <li>• Best practices check</li>
        <li>• Performance analysis</li>
        <li>• Security audit</li>
      </ul>
    </div>
    
    <div class="bg-white p-6 rounded-lg shadow">
      <h2 class="text-xl font-bold mb-3">Troubleshooting</h2>
      <p class="text-slate-600 mb-4">Debug and resolve complex VIM issues quickly.</p>
      <ul class="text-sm space-y-1 text-slate-500">
        <li>• Workflow errors</li>
        <li>• Attachment issues</li>
        <li>• Integration problems</li>
      </ul>
    </div>
  </div>
  
  <div class="mt-12 text-center">
    <a href="/contact" class="inline-block bg-cyan-600 text-white px-8 py-3 rounded-lg hover:bg-cyan-700">
      Request Consultation
    </a>
  </div>
</BaseLayout>
