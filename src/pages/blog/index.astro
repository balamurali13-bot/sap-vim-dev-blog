---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
const publishedPosts = posts.filter(p => p.data.status === 'published').sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const categoryColors: Record<string, string> = {
  'abap-snippets': 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400',
  'vim-enhancements': 'bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-400',
  'workflow': 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400',
  'fi-mm': 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400',
  'troubleshooting': 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400',
  'performance': 'bg-cyan-100 text-cyan-700 dark:bg-cyan-900/30 dark:text-cyan-400',
  'best-practices': 'bg-tag-bg text-tag-text',
};
---

<BaseLayout title="Articles">
  <!-- Header -->
  <section class="bg-gradient-to-b from-secondary to-primary dark:from-dark-secondary dark:to-dark-primary py-16">
    <div class="max-w-[1120px] mx-auto px-6">
      <h1 class="text-4xl font-bold text-text-primary mb-3 font-serif">Articles</h1>
      <p class="text-lg text-text-secondary">
        Technical guides, code snippets, and best practices for SAP practitioners.
      </p>
    </div>
  </section>

  <!-- Posts Grid -->
  <section class="py-16">
    <div class="max-w-[1120px] mx-auto px-6">
      {publishedPosts.length === 0 ? (
        <div class="text-center py-12">
          <p class="text-text-secondary text-lg">No articles yet. Check back soon!</p>
        </div>
      ) : (
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {publishedPosts.map(post => (
            <a href={`/blog/${post.slug}`} class="group bg-card dark:bg-dark-card rounded-xl border border-border hover:border-accent hover:shadow-md transition-all">
              <div class="p-5">
                <div class="flex items-center gap-2 mb-3">
                  <span class={`px-2 py-1 rounded-md text-xs font-medium ${categoryColors[post.data.category] || 'bg-tag-bg text-tag-text'}`}>
                    {post.data.category.replace('-', ' ')}
                  </span>
                  {post.data.featured && (
                    <span class="px-2 py-1 rounded-md bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400 text-xs font-medium">
                      ★ Featured
                    </span>
                  )}
                </div>
                
                <h2 class="text-lg font-semibold text-text-primary mb-2 group-hover:text-accent transition-colors line-clamp-2 font-serif">
                  {post.data.title}
                </h2>
                
                <p class="text-sm text-text-secondary mb-4 line-clamp-3">
                  {post.data.description}
                </p>
                
                <div class="flex items-center justify-between text-xs text-text-tertiary mb-4">
                  <div class="flex items-center gap-2">
                    <div class="w-6 h-6 rounded-full bg-accent flex items-center justify-center text-white text-xs font-bold">
                      {post.data.author.charAt(0).toUpperCase()}
                    </div>
                    <span>{post.data.author}</span>
                  </div>
                  <span>{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                </div>
                
                {post.data.tags && post.data.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2 pt-4 border-t border-border">
                    {post.data.tags.slice(0, 4).map(tag => (
                      <span class="px-2 py-1 rounded-md bg-tag-bg text-tag-text text-xs">#{tag}</span>
                    ))}
                  </div>
                )}
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
