---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => {
    return data.status === 'published';
  });
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

// Get author data
const authors = await getCollection('authors');
const author = authors.find(a => a.slug === post.data.author) || null;

// Get all published posts for related posts
const allPosts = await getCollection('blog', ({ data }) => data.status === 'published');

// Related posts: same category first, then by shared tags
const relatedPosts = allPosts
  .filter(p => p.slug !== post.slug)
  .map(p => ({
    post: p,
    score: (p.data.category === post.data.category ? 2 : 0) + 
           (p.data.tags?.filter(t => post.data.tags?.includes(t)).length || 0)
  }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map(r => r.post);

const categoryColors: Record<string, string> = {
  'abap-snippets': 'bg-blue-100 text-blue-700 dark:bg-blue-900/30 dark:text-blue-400',
  'vim-enhancements': 'bg-purple-100 text-purple-700 dark:bg-purple-900/30 dark:text-purple-400',
  'workflow': 'bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400',
  'fi-mm': 'bg-green-100 text-green-700 dark:bg-green-900/30 dark:text-green-400',
  'troubleshooting': 'bg-red-100 text-red-700 dark:bg-red-900/30 dark:text-red-400',
  'performance': 'bg-cyan-100 text-cyan-700 dark:bg-cyan-900/30 dark:text-cyan-400',
  'best-practices': 'bg-tag-bg text-tag-text dark:bg-dark-tag-bg dark:text-dark-tag-text',
};
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <div class="max-w-[1120px] mx-auto px-6 py-12">
    <div class="grid lg:grid-cols-4 gap-12">
      
      <!-- Main Content -->
      <article class="lg:col-span-3">
        <!-- Article Header -->
        <header class="mb-8">
          <div class="flex items-center gap-3 mb-4">
            <span class={`px-3 py-1 rounded-full text-xs font-semibold uppercase ${categoryColors[post.data.category] || 'bg-tag-bg text-tag-text'}`}>
              {post.data.category.replace('-', ' ')}
            </span>
            {post.data.featured && (
              <span class="px-3 py-1 rounded-full bg-amber-100 text-amber-700 dark:bg-amber-900/30 dark:text-amber-400 text-xs font-semibold">
                ★ Featured
              </span>
            )}
          </div>
          
          <h1 class="text-3xl sm:text-4xl font-bold text-text-primary mb-4 font-serif leading-tight">
            {post.data.title}
          </h1>
          
          <p class="text-lg text-text-secondary mb-6">
            {post.data.description}
          </p>
          
          <div class="flex items-center gap-4 text-sm text-text-tertiary">
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-full bg-gradient-to-br from-accent to-gradient-end flex items-center justify-center text-white text-sm font-bold">
                {post.data.author.charAt(0).toUpperCase()}
              </div>
              <span class="font-medium text-text-secondary">{post.data.author}</span>
            </div>
            <span>•</span>
            <time>{post.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
          </div>
        </header>
        
        <!-- Article Content -->
        <div class="prose prose-lg max-w-none 
          prose-headings:font-serif prose-headings:font-semibold
          prose-h2:text-text-primary prose-h2:mt-12 prose-h2:mb-4
          prose-h3:text-text-primary prose-h3:mt-8 prose-h3:mb-3
          prose-p:text-text-secondary prose-p:mb-4
          prose-a:text-accent prose-a:no-underline hover:prose-a:underline
          prose-code:text-accent prose-code:bg-accent-subtle dark:prose-code:bg-dark-accent-subtle prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:font-mono prose-code:text-sm
          prose-pre:bg-code dark:prose-pre:bg-dark-code prose-pre:rounded-lg prose-pre:shadow-md
          prose-li:text-text-secondary
          prose-blockquote:border-l-accent prose-blockquote:bg-secondary dark:prose-blockquote:bg-dark-secondary prose-blockquote:px-4 prose-blockquote:py-2 prose-blockquote:rounded-r-lg prose-blockquote:not-italic">
          <Content />
        </div>
        
        <!-- Tags -->
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="mt-10 pt-8 border-t border-border">
            <div class="flex flex-wrap gap-2">
              {post.data.tags.map(tag => (
                <span class="px-3 py-1.5 rounded-lg bg-tag-bg dark:bg-dark-tag-bg text-tag-text dark:text-dark-tag-text text-sm">
                  #{tag}
                </span>
              ))}
            </div>
          </div>
        )}
        
        <!-- Back Link -->
        <div class="mt-8 pt-8 border-t border-border">
          <a href="/blog" class="inline-flex items-center gap-2 text-accent font-medium hover:gap-3 transition-all">
            ← Back to Articles
          </a>
        </div>
      </article>
      
      <!-- Sidebar -->
      <aside class="lg:col-span-1 space-y-6">
        <!-- Table of Contents -->
        {headings.length > 0 && (
          <div class="bg-card dark:bg-dark-card rounded-xl border border-border p-5 sticky top-24">
            <h3 class="font-semibold text-text-primary mb-4">On this page</h3>
            <nav class="space-y-2 text-sm">
              {headings.filter(h => h.depth <= 3).map(heading => (
                <a 
                  href={`#${heading.slug}`} 
                  class={`block text-text-secondary hover:text-accent transition-colors ${heading.depth === 3 ? 'pl-4' : ''}`}
                >
                  {heading.text}
                </a>
              ))}
            </nav>
          </div>
        )}
        
        <!-- Author Card -->
        {author && (
          <div class="bg-card dark:bg-dark-card rounded-xl border border-border p-5">
            <h3 class="font-semibold text-text-primary mb-4">About the Author</h3>
            <div class="flex items-start gap-3">
              <div class="w-12 h-12 rounded-full bg-gradient-to-br from-accent to-gradient-end flex items-center justify-center text-white font-bold flex-shrink-0">
                {author.data.name.charAt(0)}
              </div>
              <div>
                <h4 class="font-semibold text-text-primary">{author.data.name}</h4>
                <p class="text-sm text-accent">{author.data.role}</p>
              </div>
            </div>
            <p class="mt-4 text-sm text-text-secondary">
              {author.data.bio}
            </p>
            {author.data.expertise && (
              <div class="mt-4 flex flex-wrap gap-2">
                {author.data.expertise.slice(0, 3).map(skill => (
                  <span class="px-2 py-1 rounded-md bg-tag-bg dark:bg-dark-tag-bg text-tag-text dark:text-dark-tag-text text-xs">
                    {skill}
                  </span>
                ))}
              </div>
            )}
          </div>
        )}
      </aside>
    </div>
    
    <!-- Related Posts -->
    {relatedPosts.length > 0 && (
      <section class="mt-16 pt-12 border-t border-border">
        <h2 class="text-2xl font-bold text-text-primary mb-8 font-serif">Related Articles</h2>
        <div class="grid md:grid-cols-3 gap-6">
          {relatedPosts.map(related => (
            <a href={`/blog/${related.slug}`} class="group bg-card dark:bg-dark-card rounded-xl border border-border hover:border-accent hover:shadow-md transition-all">
              <div class="p-5">
                <span class={`inline-block px-2 py-1 rounded-md text-xs font-medium mb-3 ${categoryColors[related.data.category] || 'bg-tag-bg text-tag-text'}`}>
                  {related.data.category.replace('-', ' ')}
                </span>
                <h3 class="font-semibold text-text-primary mb-2 group-hover:text-accent transition-colors line-clamp-2">
                  {related.data.title}
                </h3>
                <p class="text-sm text-text-secondary line-clamp-2">
                  {related.data.description}
                </p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
