---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => {
    return data.status === 'published';
  });
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

// Get author data - exact slug match
const authors = await getCollection('authors');
const author = authors.find(a => a.slug === post.data.author) || null;

// Get all published posts for related posts
const allPosts = await getCollection('blog', ({ data }) => data.status === 'published');

// Related posts: same category first, then by shared tags
const relatedPosts = allPosts
  .filter(p => p.slug !== post.slug)
  .map(p => ({
    post: p,
    score: (p.data.category === post.data.category ? 2 : 0) + 
           (p.data.tags?.filter(t => post.data.tags?.includes(t)).length || 0)
  }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 3)
  .map(r => r.post);

const categoryColors: Record<string, string> = {
  'abap-snippets': 'bg-blue-100 dark:bg-blue-900/30 text-blue-700 dark:text-blue-400',
  'vim-enhancements': 'bg-purple-100 dark:bg-purple-900/30 text-purple-700 dark:text-purple-400',
  'workflow': 'bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400',
  'fi-mm': 'bg-green-100 dark:bg-green-900/30 text-green-700 dark:text-green-400',
  'troubleshooting': 'bg-red-100 dark:bg-red-900/30 text-red-700 dark:text-red-400',
  'performance': 'bg-cyan-100 dark:bg-cyan-900/30 text-cyan-700 dark:text-cyan-400',
  'best-practices': 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-400',
};
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid lg:grid-cols-4 gap-8">
      
      <!-- Main Content -->
      <article class="lg:col-span-3">
        <!-- Article Header -->
        <header class="mb-8">
          <div class="flex items-center gap-3 mb-4">
            <span class={`px-3 py-1 rounded-full text-xs font-semibold uppercase ${categoryColors[post.data.category] || 'bg-slate-100 text-slate-700'}`}>
              {post.data.category.replace('-', ' ')}
            </span>
            {post.data.featured && (
              <span class="px-3 py-1 rounded-full bg-amber-100 dark:bg-amber-900/30 text-amber-700 dark:text-amber-400 text-xs font-semibold">
                ★ Featured
              </span>
            )}
          </div>
          
          <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold text-slate-900 dark:text-white mb-4 leading-tight">
            {post.data.title}
          </h1>
          
          <p class="text-lg text-slate-600 dark:text-slate-300 mb-6">
            {post.data.description}
          </p>
          
          <div class="flex items-center gap-4 text-sm text-slate-500 dark:text-slate-400">
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-full bg-gradient-to-br from-purple-500 to-purple-600 flex items-center justify-center text-white text-sm font-bold">
                {post.data.author.split('-').map((w: string) => w.charAt(0)).join('')}
              </div>
              <span class="font-medium">{post.data.author.split('-').map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(' ')}</span>
            </div>
            <span>•</span>
            <time>{post.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</time>
          </div>
        </header>
        
        <!-- Article Content -->
        <div class="prose prose-lg dark:prose-invert max-w-none 
          prose-headings:scroll-mt-20
          prose-h2:text-slate-900 dark:prose-h2:text-white
          prose-h3:text-slate-800 dark:prose-h3:text-white
          prose-p:text-slate-700 dark:prose-p:text-slate-300
          prose-a:text-cyan-600 dark:prose-a:text-cyan-400
          prose-code:text-cyan-600 dark:prose-code:text-cyan-400 prose-code:bg-cyan-50 dark:prose-code:bg-cyan-900/20 prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded-md prose-code:before:content-none prose-code:after:content-none
          prose-pre:bg-slate-900 dark:prose-pre:bg-slate-950 prose-pre:border prose-pre:border-slate-700
          prose-li:text-slate-700 dark:prose-li:text-slate-300
          prose-blockquote:border-l-cyan-500 prose-blockquote:bg-slate-50 dark:prose-blockquote:bg-slate-800 prose-blockquote:px-4 prose-blockquote:py-2 prose-blockquote:rounded-r-lg">
          <Content />
        </div>
        
        <!-- Tags -->
        {post.data.tags && post.data.tags.length > 0 && (
          <div class="mt-8 pt-8 border-t border-slate-200 dark:border-slate-700">
            <div class="flex flex-wrap gap-2">
              {post.data.tags.map(tag => (
                <span class="px-3 py-1 rounded-full bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-400 text-sm">
                  #{tag}
                </span>
              ))}
            </div>
          </div>
        )}
        
        <!-- Back Link -->
        <div class="mt-8 pt-8 border-t border-slate-200 dark:border-slate-700">
          <a href="/blog" class="inline-flex items-center gap-2 text-cyan-600 dark:text-cyan-400 font-semibold hover:gap-3 transition-all">
            ← Back to Articles
          </a>
        </div>
      </article>
      
      <!-- Sidebar -->
      <aside class="lg:col-span-1 space-y-8">
        <!-- Table of Contents -->
        {headings.length > 0 && (
          <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6 sticky top-24">
            <h3 class="font-semibold text-slate-900 dark:text-white mb-4">On this page</h3>
            <nav class="space-y-2 text-sm">
              {headings.filter(h => h.depth <= 3).map(heading => (
                <a 
                  href={`#${heading.slug}`} 
                  class={`block text-slate-600 dark:text-slate-400 hover:text-cyan-600 dark:hover:text-cyan-400 transition-colors ${heading.depth === 3 ? 'pl-4' : ''}`}
                >
                  {heading.text}
                </a>
              ))}
            </nav>
          </div>
        )}
        
        <!-- Author Card -->
        {author ? (
          <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6">
            <h3 class="font-semibold text-slate-900 dark:text-white mb-4">About the Author</h3>
            <div class="flex items-start gap-4">
              <div class="w-14 h-14 rounded-full bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center text-white text-xl font-bold flex-shrink-0">
                {author.data.name.charAt(0)}
              </div>
              <div>
                <h4 class="font-semibold text-slate-900 dark:text-white">{author.data.name}</h4>
                <p class="text-sm text-cyan-600 dark:text-cyan-400">{author.data.role}</p>
              </div>
            </div>
            <p class="mt-4 text-sm text-slate-600 dark:text-slate-400">
              {author.data.bio}
            </p>
            {author.data.expertise && (
              <div class="mt-4 flex flex-wrap gap-2">
                {author.data.expertise.slice(0, 3).map(skill => (
                  <span class="px-2 py-1 rounded-md bg-slate-100 dark:bg-slate-700 text-slate-600 dark:text-slate-400 text-xs">
                    {skill}
                  </span>
                ))}
              </div>
            )}
          </div>
        ) : (
          <div class="bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 p-6">
            <h3 class="font-semibold text-slate-900 dark:text-white mb-4">About the Author</h3>
            <div class="flex items-center gap-4">
              <div class="w-14 h-14 rounded-full bg-slate-200 dark:bg-slate-700 flex items-center justify-center text-slate-500 dark:text-slate-400 text-xl font-bold">
                {post.data.author.charAt(0).toUpperCase()}
              </div>
              <div>
                <h4 class="font-semibold text-slate-900 dark:text-white">{post.data.author}</h4>
                <p class="text-sm text-slate-500">Author</p>
              </div>
            </div>
          </div>
        )}
      </aside>
    </div>
    
    <!-- Related Posts -->
    {relatedPosts.length > 0 && (
      <section class="mt-16 pt-12 border-t border-slate-200 dark:border-slate-700">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-8">Related Articles</h2>
        <div class="grid md:grid-cols-3 gap-6">
          {relatedPosts.map(related => (
            <a href={`/blog/${related.slug}`} class="group bg-white dark:bg-slate-800 rounded-xl border border-slate-200 dark:border-slate-700 overflow-hidden hover:border-cyan-300 dark:hover:border-cyan-600 transition-all">
              <div class="p-5">
                <span class={`inline-block px-2 py-1 rounded-md text-xs font-medium mb-3 ${categoryColors[related.data.category] || 'bg-slate-100 text-slate-600'}`}>
                  {related.data.category.replace('-', ' ')}
                </span>
                <h3 class="font-semibold text-slate-900 dark:text-white mb-2 group-hover:text-cyan-600 dark:group-hover:text-cyan-400 transition-colors line-clamp-2">
                  {related.data.title}
                </h3>
                <p class="text-sm text-slate-600 dark:text-slate-400 line-clamp-2">
                  {related.data.description}
                </p>
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
