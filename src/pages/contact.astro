---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact">
  <h1 class="text-4xl font-bold mb-8">Contact Us</h1>
  
  <div class="grid md:grid-cols-2 gap-12">
    <div>
      <h2 class="text-2xl font-semibold mb-4">Get in Touch</h2>
      <p class="text-slate-600 mb-6">
        Need help with your SAP VIM implementation? We offer consultation, code reviews, and troubleshooting services.
      </p>
      
      <div class="space-y-4">
        <div>
          <h3 class="font-semibold">Email</h3>
          <a href="mailto:hello@sapvim.blog" class="text-cyan-600">hello@sapvim.blog</a>
        </div>
        <div>
          <h3 class="font-semibold">Services</h3>
          <ul class="text-slate-600">
            <li>• SAP VIM Implementation</li>
            <li>• ABAP Development</li>
            <li>• Code Review</li>
            <li>• Troubleshooting</li>
          </ul>
        </div>
      </div>
    </div>
    
    <form class="bg-white p-6 rounded-lg shadow space-y-4">
      <div>
        <label class="block text-sm font-medium mb-1">Name</label>
        <input type="text" class="w-full p-2 border rounded" required>
      </div>
      <div>
        <label class="block text-sm font-medium mb-1">Email</label>
        <input type="email" class="w-full p-2 border rounded" required>
      </div>
      <div>
        <label class="block text-sm font-medium mb-1">Service Type</label>
        <select class="w-full p-2 border rounded">
          <option>General Inquiry</option>
          <option>Consultation</option>
          <option>Code Review</option>
          <option>VIM Support</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium mb-1">Message</label>
        <textarea class="w-full p-2 border rounded" rows="4" required></textarea>
      </div>
      <button type="submit" class="w-full bg-cyan-600 text-white py-2 rounded hover:bg-cyan-700">
        Send Message
      </button>
    </form>
  </div>
</BaseLayout>
